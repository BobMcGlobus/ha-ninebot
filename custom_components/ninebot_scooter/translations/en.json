{
  "config": {
    "flow_title": "{name}",
    "step": {
      "bluetooth_confirm": {
        "description": "Do you want to set up {name}?\n\nAfter setup, on the first poll press the power button on the scooter once when asked, to confirm pairing.\n\n⚠️ Confirmed on hardware: MAX G30/G30D (sensors and controls), F40 and Max G3 (sensors only). A Max G3 already paired with the Segway app needs its pairing password entered under Configure. Other models (G2, F2, E-series …) are under active development and may not work yet — reports and diagnostics are welcome."
      },
      "user": {
        "description": "Choose the Ninebot scooter to set up.\n{note}\n\n⚠️ Confirmed on hardware: MAX G30/G30D (sensors and controls), F40 and Max G3 (sensors only). A Max G3 already paired with the Segway app needs its pairing password entered under Configure. Other models (G2, F2, E-series …) are under active development and may not work yet — reports and diagnostics are welcome.",
        "data": {
          "address": "Bluetooth device"
        }
      }
    },
    "abort": {
      "no_devices_found": "No unconfigured Ninebot scooters found nearby. Wake the scooter and make sure it is within Bluetooth range.",
      "already_configured": "This scooter is already configured.",
      "already_in_progress": "Configuration is already in progress.",
      "not_supported": "This device is not supported."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Ninebot options",
        "data": {
          "poll_interval": "Polling interval (seconds)",
          "parked_poll_interval": "Parked polling interval (minutes)",
          "v2_password": "Pairing password (hex, optional)",
          "poll_timeout": "Poll timeout (seconds)"
        },
        "data_description": {
          "poll_interval": "How often to connect and read the scooter while it is awake. Lower is more responsive but uses more Bluetooth airtime and battery.",
          "parked_poll_interval": "How often to read the scooter while it is parked but still in Bluetooth range. 0 turns this off. A sleeping scooter wakes up for each read, and some models chime when they do. Whether a read keeps an older model from switching itself off is not yet known.",
          "v2_password": "Only needed for scooters that are already linked to the official Segway-Ninebot app and therefore refuse a new pairing: newer models such as the Max G3, and classic ones such as the Max G2. The app's SERIAL_decrypt value, 32 hex characters. Leave empty otherwise.",
          "poll_timeout": "How long a single reading may take before it is given up. A reading that started while the scooter was riding past would otherwise block the next one. It also bounds the first-time pairing window, which gets this value minus 25 s - so raise it if you need longer to press the power button."
        }
      }
    },
    "error": {
      "invalid_password": "Must be 32 hex characters (16 bytes)."
    }
  },
  "services": {
    "read_register": {
      "name": "Read register",
      "description": "Read one register straight off the scooter, by raw address. For working out where an unmapped model keeps a value.",
      "fields": {
        "device_id": {
          "name": "Scooter",
          "description": "Which scooter to read from."
        },
        "board": {
          "name": "Board",
          "description": "Which board to ask. Classic protocol: 32 control, 33 Bluetooth, 34 battery. Newer protocol: 1 dashboard, 22 vehicle controller."
        },
        "index": {
          "name": "Register",
          "description": "Register address to read."
        },
        "length": {
          "name": "Length",
          "description": "Bytes to read. Two covers most values."
        }
      }
    },
    "scan_registers": {
      "name": "Scan registers",
      "description": "Read a run of registers in one connection. Sweep once, change something on the scooter, sweep again, and compare: the register that moved is the one you were looking for.",
      "fields": {
        "device_id": {
          "name": "Scooter",
          "description": "Which scooter to read from."
        },
        "board": {
          "name": "Board",
          "description": "Which board to sweep."
        },
        "start": {
          "name": "First register",
          "description": "Address to start at."
        },
        "count": {
          "name": "How many",
          "description": "Registers to read. The scooter must stay awake for the whole sweep."
        },
        "length": {
          "name": "Length",
          "description": "Bytes per register."
        }
      }
    }
  },
