{
  "config": {
    "flow_title": "{name}",
    "step": {
      "bluetooth_confirm": {
        "description": "Möchtest du {name} einrichten?\n\nNach der Einrichtung beim ersten Abruf einmal den Power-Knopf am Roller drücken, wenn danach gefragt wird, um das Pairing zu bestätigen.\n\n⚠️ Auf Hardware bestätigt: MAX G30/G30D (Sensoren und Steuerung), F40 und Max G3 (nur Sensoren). Ein bereits mit der Segway-App gekoppelter Max G3 braucht sein Pairing-Passwort unter „Konfigurieren“. Weitere Modelle (G2, F2, E-Serie …) werden gerade aktiv entwickelt und funktionieren evtl. noch nicht — Rückmeldungen und Diagnosedaten sind willkommen."
      },
      "user": {
        "description": "Wähle den einzurichtenden Ninebot-Roller aus.\n{note}\n\n⚠️ Auf Hardware bestätigt: MAX G30/G30D (Sensoren und Steuerung), F40 und Max G3 (nur Sensoren). Ein bereits mit der Segway-App gekoppelter Max G3 braucht sein Pairing-Passwort unter „Konfigurieren“. Weitere Modelle (G2, F2, E-Serie …) werden gerade aktiv entwickelt und funktionieren evtl. noch nicht — Rückmeldungen und Diagnosedaten sind willkommen.",
        "data": {
          "address": "Bluetooth-Gerät"
        }
      }
    },
    "abort": {
      "no_devices_found": "Kein nicht eingerichteter Ninebot-Roller in der Nähe gefunden. Wecke den Roller auf und stelle sicher, dass er in Bluetooth-Reichweite ist.",
      "already_configured": "Dieser Roller ist bereits eingerichtet.",
      "already_in_progress": "Die Einrichtung läuft bereits.",
      "not_supported": "Dieses Gerät wird nicht unterstützt."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Ninebot-Optionen",
        "data": {
          "poll_interval": "Abrufintervall (Sekunden)",
          "parked_poll_interval": "Abrufintervall im Stand (Minuten)",
          "v2_password": "Pairing-Passwort (hex, optional)",
          "poll_timeout": "Poll-Timeout (Sekunden)"
        },
        "data_description": {
          "poll_interval": "Wie oft der Roller (wenn wach) verbunden und ausgelesen wird. Kleiner = reaktionsschneller, aber mehr Bluetooth-Last und Akkuverbrauch.",
          "parked_poll_interval": "Wie oft der Roller ausgelesen wird, solange er abgestellt, aber noch in Bluetooth-Reichweite ist. 0 schaltet das ab. Ein schlafender Roller wacht für jeden Abruf auf, und manche Modelle geben dabei einen Signalton ab. Ob ein Abruf ältere Modelle davon abhält, sich selbst abzuschalten, ist noch nicht bekannt.",
          "v2_password": "Nur nötig für Scooter, die bereits mit der offiziellen Segway-Ninebot-App verknüpft sind und deshalb kein neues Pairing annehmen: neuere Modelle wie der Max G3 und klassische wie der Max G2. Der Wert SERIAL_decrypt aus der App, 32 Hex-Zeichen. Sonst leer lassen.",
          "poll_timeout": "Wie lange ein einzelner Abruf dauern darf, bevor er abgebrochen wird. Ein Abruf, der während der Vorbeifahrt gestartet wurde, würde sonst den nächsten blockieren. Begrenzt auch das Pairing-Fenster beim ersten Mal: dieser Wert minus 25 s - also erhöhen, wenn du länger brauchst, um den Power-Knopf zu drücken."
        }
      }
    },
    "error": {
      "invalid_password": "Muss aus 32 Hex-Zeichen (16 Byte) bestehen."
    }
  },
